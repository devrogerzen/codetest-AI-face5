# Copiá este archivo como .env y completá tu key (el .env NO se sube a GitHub)

# LLM del agente: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Opcional: cualquier API compatible con OpenAI (con su propia key y modelo)
# OPENAI_BASE_URL=

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# Opcionales
# RECURSION_LIMIT=10
# SIMULAR_FALLAS=1      # 0 para apagar la falla simulada del servicio de envíos
